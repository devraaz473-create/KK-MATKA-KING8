# Copy to an untracked .env file for local development. Never commit real values.
GEMINI_API_KEY="replace-with-your-key"

# Required in production; exact HTTPS origin only.
APP_URL="https://your-app.example.com"

# Optional. Comma-separated HTTPS origins, with no path.
CORS_ORIGINS=""

# Optional database file path. In production, point this at persistent storage.
DB_PATH=""

# Set these only when deliberately creating a new, empty database.
ADMIN_USERNAME="ADMIN"
ADMIN_PASSWORD=""
DB_INITIALIZE="false"

# Set to production only in the hosting service.
NODE_ENV="development"
PORT="3000"

# Optional when building Android; use the deployed HTTPS API origin.
VITE_API_BASE_URL=""
